PORT=3000
# Use mongodb://localhost:27017/quizapp for local MongoDB,
# mongodb://mongo:27017/quizapp for Docker Compose,
# or "memory" for an ephemeral in-memory DB (dev only).
MONGODB_URI=mongodb://localhost:27017/quizapp
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000
QUESTION_TIME_SECONDS=15

# Password reset (Resend) — never commit real keys
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=QuiZapp <onboarding@resend.dev>
RESET_TOKEN_EXPIRES_MINUTES=30
